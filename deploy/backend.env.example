# /etc/ludo-arena/backend.env (mode 0640 root:ludo). provision.sh renders it
# from this template on first run and fills every __GENERATED__ value with
# a fresh random secret; it never overwrites an existing file.
# systemd EnvironmentFile syntax: no inline comments, no quotes needed.
# Option reference: backend/.env.example.

APP_ENV=production
HTTP_ADDR=127.0.0.1:8080
METRICS_ADDR=127.0.0.1:9090
LOG_LEVEL=info
PUBLIC_URL=https://ludo.sungamestudio.com
TRUSTED_PROXY_HOPS=1

DATABASE_URL=postgres://ludo:__DB_PASSWORD__@127.0.0.1:5432/ludo_arena?sslmode=disable
DB_MAX_CONNS=20

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_DB=0
REDIS_TLS=false

JWT_SIGNING_KEY=__GENERATED__
JWT_ISSUER=ludo-arena
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PUBLIC_ID_KEY=__GENERATED__
ACTIVE_USER_KEY=__GENERATED__

GOOGLE_CLIENT_IDS=124893613050-93on2291jjunnk5u95lcpk15pk6vgr6c.apps.googleusercontent.com
APPLE_AUDIENCES=com.ludoarena.app,com.ludoarena.app.signin
APPLE_ANDROID_PACKAGE=com.ludoarena.app
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

APP_POLICY_FILE=config/app-policy.production.json
APP_MAINTENANCE_FLAG_FILE=/etc/ludo-arena/MAINTENANCE
APP_POLICY_POLL_SECONDS=5s

WS_COMPRESSION=no_context_takeover
WS_COMPRESSION_THRESHOLD=1024
WS_MAX_CONNECTIONS=50000

BOT_SERVICE_KEY_SHA256=__BOT_SERVICE_KEY_SHA256__
BOT_PUBLIC_FILL_ENABLED=false
BOT_LOADTEST_ENABLED=false

ADMIN_API_KEY_SHA256=

PROGRESSION_MIN_MATCH_DURATION=30s

R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_PACKAGE_NAME=com.ludoarena.app
APPLE_IAP_ENABLED=true
APPLE_IAP_ALLOW_SANDBOX=true
APPLE_BUNDLE_ID=com.ludoarena.app

RATE_LIMIT_DISABLED=false
