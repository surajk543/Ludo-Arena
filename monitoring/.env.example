# Ludo Arena ops bot configuration. Copy to .env (gitignored) and fill in.
# Never commit real tokens or keys; never paste the bot token into a chat.

# --- Telegram (required unless TELEGRAM_DRY_RUN=true) ---
TELEGRAM_BOT_TOKEN=CHANGE_ME_FROM_BOTFATHER
# Comma-separated chat ids: your user id, a group id (negative) or @channel.
TELEGRAM_CHAT_IDS=CHANGE_ME
# Answer /live, /playtime, /metrics, /status, /digest and /help from the chats above.
TELEGRAM_COMMANDS=true
# A command's report is cancelled when not generated within this.
COMMAND_REPORT_TIMEOUT=30s
# The same command from the same chat within this window is dropped (0 disables).
COMMAND_DEDUPE_WINDOW=30s
# Minimum gap between two messages to the same chat (Telegram: ~20/min per group).
TELEGRAM_MIN_GAP=3s
# Log messages (and write PDFs to DRY_RUN_DIR) instead of sending them.
TELEGRAM_DRY_RUN=false
DRY_RUN_DIR=
# Override only for tests (a fake Bot API).
TELEGRAM_API_URL=https://api.telegram.org

# --- Identity and time ---
ENV_NAME=development
TZ_NAME=Asia/Kolkata

# --- Reports ---
# Hourly status every STATUS_INTERVAL (0 disables), aligned to local clock multiples.
STATUS_INTERVAL=1h
STATUS_ALIGN=true
STATUS_ON_START=false
# Daily KPI report for yesterday at this local time ("off" disables).
DAILY_REPORT_AT=09:00
# pdf (charts, sent as a document) or text (a message).
REPORT_FORMAT=pdf
# Alerts: text (instant, readable) or pdf (one page with last-hour charts).
ALERT_FORMAT=text
# Drop a repeat of the same alert+status within this window (keep it below
# Alertmanager's repeat_interval of 1h).
ALERT_DEDUPE_WINDOW=30m
TREND_DAYS=30

# --- Prometheus (the compose file sets PROM_URL and HTTP_ADDR for containers) ---
PROM_URL=http://127.0.0.1:9095
PROM_TIMEOUT=20s
HTTP_ADDR=127.0.0.1:9097
BACKEND_JOB=backend
BOTPLAY_JOB=bot-play
NODE_JOB=node
# Optional shared secret Alertmanager must send (Authorization: Bearer ...).
WEBHOOK_BEARER_TOKEN=

# --- Backend operator API (player lists of /live and /playtime; optional) ---
# REST base on the private network; from compose: http://host.docker.internal:8080
BACKEND_API_URL=
# Operator key (secret). The backend's ADMIN_API_KEY_SHA256 must be its sha256:
#   printf %s "$BACKEND_ADMIN_KEY" | sha256sum
BACKEND_ADMIN_KEY=

# --- Google KPIs (optional; each section says "not configured" when unset) ---
# Play Console > Download reports > Statistics > copy Cloud Storage URI (gs://pubsite_prod_...).
PLAY_REPORTS_BUCKET=
PLAY_PACKAGE_NAME=com.sungamestudio.ludoarena
# GA4 property id of the Firebase project (Admin > Property settings), digits only.
GA4_PROPERTY_ID=
# Path of a service-account JSON key inside the container (mounted from ./secrets).
GOOGLE_APPLICATION_CREDENTIALS=

LOG_LEVEL=info
