  "widgetsTitleLabel": "Title: {title}",
  "@widgetsTitleLabel": {
    "description": "Screen-reader label of a player title chip.",
    "placeholders": {
      "title": {
        "type": "String"
      }
    }
  },
  "widgetsEmoteLabel": "Emote: {name}",
  "@widgetsEmoteLabel": {
    "description": "Screen-reader label of an emote icon.",
    "placeholders": {
      "name": {
        "type": "String"
      }
    }
  },
  "widgetsBadgeLabel": "Badge: {name}",
  "@widgetsBadgeLabel": {
    "description": "Screen-reader label of a badge icon.",
    "placeholders": {
      "name": {
        "type": "String"
      }
    }
  },
