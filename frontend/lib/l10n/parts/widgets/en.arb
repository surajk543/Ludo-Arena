      "amount": {
        "type": "String"
      }
    }
  },
  "widgetsDiamondsBalance": "Diamonds: {amount}",
  "@widgetsDiamondsBalance": {
    "description": "Screen-reader label of the diamond balance chip.",
    "placeholders": {
      "amount": {
        "type": "String"
      }
    }
  },
