<?xml version="1.0" encoding="utf-8"?>
<!-- Session credentials live in the Android Keystore-backed secure storage and
     cannot be restored on another device, so nothing is backed up or
     transferred. The server keeps all progress. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
