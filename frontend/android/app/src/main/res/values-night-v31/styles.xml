<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash (dark). Needed in addition to values-v31:
         the night qualifier outranks the API level, so values-night/styles.xml
         would otherwise win on Android 12+ in dark mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
