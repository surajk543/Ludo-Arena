# Ludo Royale backend configuration (copy to .env for local development).
# Values below are PLACEHOLDERS. Never commit real secrets.

APP_ENV=development                  # development | preproduction | production
HTTP_ADDR=:8080
METRICS_ADDR=127.0.0.1:9090          # Prometheus /metrics (keep internal)
GAME_STATS_INTERVAL=15s              # recount of the cluster-wide live-game gauges (>= 1s)
LOG_LEVEL=info
PUBLIC_URL=http://localhost:8080     # used for the Apple Android callback
TRUSTED_PROXY_HOPS=0                 # number of reverse proxies adding X-Forwarded-For

# PostgreSQL (schemas: wallet, identity, progression) — never expose publicly
DATABASE_URL=postgres://ludo:CHANGE_ME@127.0.0.1:5432/ludo_royale?sslmode=disable
DB_MAX_CONNS=20

# Redis (live rooms, matchmaking, sessions, presence, rate limits)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Application sessions (generate: openssl rand -base64 48)
JWT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG________
JWT_ISSUER=ludo-royale
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Keys public player ids and (domain-separated) device-binding subjects;
# keep it stable: rotating it orphans every device binding.
PUBLIC_ID_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG________
ACTIVE_USER_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG________

# Identity providers (audiences are public client ids; secrets stay server-side)
# Google: the Web application client id (used as serverClientId by the app).
GOOGLE_CLIENT_IDS=124893613050-93on2291jjunnk5u95lcpk15pk6vgr6c.apps.googleusercontent.com
# Apple: iOS bundle id and (for Android web flow) the Services ID.
APPLE_AUDIENCES=com.ludoroyale.app
APPLE_ANDROID_PACKAGE=com.ludoroyale.app
# Facebook: app id is public; the app secret is a SECRET (classic token check).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# App version / maintenance policy (see docs/app-version-policy.md)
APP_POLICY_FILE=config/app-policy.development.json
APP_MAINTENANCE_FLAG_FILE=/tmp/ludo-royale-MAINTENANCE
APP_POLICY_POLL_SECONDS=5s

# Gameplay
TURN_SECONDS=20s
TURN_SECONDS_DISCONNECTED=8s
# Consecutive missed turns (turn timeouts) that remove a player from the game (>= 1)
MAX_STRIKES=5
MATCHMAKING_FILL_SECONDS=30s
LOBBY_DISCONNECT_GRACE_SECONDS=15s
REMATCH_SECONDS=30s
PRACTICE_BOT_WAIT_SECONDS=20s
# Fallback entry fees in coins (0..100000000). The "entryFees" object in
# APP_POLICY_FILE overrides these and is hot-reloaded without a restart.
ENTRY_FEE_LUDO=100000
ENTRY_FEE_SNAKES=50000
# Fallback one-time welcome grant for new accounts (coins 0..1000000000,
# diamonds 0..1000000). The "welcome" object in APP_POLICY_FILE overrides
# these live, for accounts created after the change.
WELCOME_COINS=1000000
WELCOME_DIAMONDS=50

# WebSocket (see docs/websocket-protocol.md and docs/performance.md)
WS_COMPRESSION=no_context_takeover   # disabled | no_context_takeover | context_takeover
WS_COMPRESSION_THRESHOLD=1024        # bytes; smaller messages are sent uncompressed
WS_READ_LIMIT=4096                   # max inbound message size AFTER decompression
WS_OUTBOUND_QUEUE=128
WS_WRITE_TIMEOUT=10s
WS_PING_INTERVAL=20s
WS_PONG_TIMEOUT=10s
WS_MSG_RATE=10                       # per-connection commands/second
WS_MSG_BURST=20
WS_MAX_CONNECTIONS=50000
WS_FULL_SNAPSHOTS=false              # benchmark only: attach full snapshots to deltas

# Bot service boundary (bot-play). Store only the SHA-256 of the shared key:
#   printf '%s' "$BOT_SERVICE_KEY" | shasum -a 256
BOT_SERVICE_KEY_SHA256=
BOT_PUBLIC_FILL_ENABLED=false
BOT_MAX_PER_ROOM=3
BOT_LOADTEST_ENABLED=false           # must be false in production (enforced)
BOT_SESSION_TTL=2h
BOT_ASSIGNMENT_TTL=30s

# Social: accepted friends per account (>= 1). Accounts already above it keep
# their friends but cannot add more.
FRIENDS_MAX=20
# Player reports per account in any rolling 24 h (>= 1).
REPORTS_PER_DAY=2
# Operator API (/api/v1/admin/*, player-report review). Store only the SHA-256
# of the key sent as X-Admin-Key; empty disables the API (404). Private network only.
#   printf '%s' "$ADMIN_API_KEY" | shasum -a 256
ADMIN_API_KEY_SHA256=

# Anti-farming: minimum match length that earns XP/mission progress (>= 10s in production)
PROGRESSION_MIN_MATCH_DURATION=30s
CATALOG_FILE=config/catalog.json
MISSIONS_FILE=config/missions.json
# Open-source notices page served at GET /legal/open-source (404 if missing; reloaded on SIGHUP)
LEGAL_NOTICES_FILE=config/legal/open-source-notices.html

# Profile pictures (Store): PRIVATE Cloudflare R2 bucket (production bucket
# name: ludo-royale), see docs/cosmetics-catalog.md "Profile pictures". Set
# all four R2_* or none: a partial set is refused at startup. Without them the
# Store still lists/sells/applies and POST /api/v1/assets/sign answers 503
# assets_unavailable. The access key pair is a SECRET (R2 API token with
# Object Read & Write on that bucket only); never commit it.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ASSET_URL_TTL=10m                    # presigned GET lifetime (1m..1h)
# Long-run share of bot seats (0..1) that wear an active profile picture.
BOT_PICTURE_SHARE=0.3
# A bot persona keeps its picture (or none) for MIN..MAX matches, then its
# wardrobe changes (1 <= MIN <= MAX <= 100).
BOT_PICTURE_KEEP_MIN=2
BOT_PICTURE_KEEP_MAX=5
# How long an unused bot persona (look, level, picture, public id) is kept.
# Its id (and coin wallet) is derived from pool + name + slot and survives this.
BOT_PERSONA_TTL=720h
# Bot coins (docs/game-rules.md "Coins with bots"): every bot persona has a
# wallet.wallets row flagged is_bot. It starts with BOT_COINS_START; below
# RECHARGE_BELOW (after a settlement or before an entry fee) it is set to
# RECHARGE_TO; above RESET_ABOVE it is set to RESET_TO before its next match.
# Whole coins in 1..1e12, refused at startup unless
# RECHARGE_BELOW < RECHARGE_TO <= RESET_ABOVE and START, RESET_TO lie in
# [RECHARGE_BELOW, RESET_ABOVE].
BOT_COINS_START=10000000            # 1 crore
BOT_COINS_RECHARGE_BELOW=100000     # 1 lakh
BOT_COINS_RECHARGE_TO=10000000      # 1 crore
BOT_COINS_RESET_ABOVE=100000000     # 10 crore
BOT_COINS_RESET_TO=10000000         # 1 crore

# Coin packs (in-app purchases), see docs/in-app-purchases.md. The pack list
# (prices, coins, diamonds, store product ids) is config/coin_packs.json,
# reloaded when it changes. Without a store's settings its purchases answer
# 503 iap_unavailable (the Shop still lists the packs). Key files are SECRETS:
# keep them outside the repository and never commit them.
COIN_PACKS_FILE=config/coin_packs.json
# Google Play: path to the service account JSON key (Play Console → Users and
# permissions: "View financial data" + "Manage orders and subscriptions").
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_PACKAGE_NAME=com.ludoroyale.app
# Refunds: poll the Voided Purchases API (0 disables; >= 1m in production)
# looking back this far each time (1h..720h).
GOOGLE_PLAY_VOIDED_POLL_INTERVAL=1h
GOOGLE_PLAY_VOIDED_LOOKBACK=168h
# App Store: verify StoreKit 2 signed transactions against Apple Root CA - G3
# (embedded). true enables it; the optional App Store Server API key (all
# three or none) also re-reads every transaction from Apple before a grant.
APPLE_IAP_ENABLED=false
APPLE_BUNDLE_ID=com.ludoroyale.app
APPLE_IAP_ALLOW_SANDBOX=true         # App Review / TestFlight buy in the sandbox
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_FILE=

# Display names: successful PATCH /api/v1/me name changes per account per
# rolling 24 h (>= 1). Not affected by RATE_LIMIT_DISABLED.
NAME_CHANGES_PER_DAY=3
# Load tests only (refused in production)
RATE_LIMIT_DISABLED=false
